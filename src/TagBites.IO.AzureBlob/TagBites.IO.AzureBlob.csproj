<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>TagBites.IO.AzureBlob</RootNamespace>
  </PropertyGroup>

  <!-- Build -->
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Package info -->
  <PropertyGroup>
    <Description>Azure Blob Storage file system support for TagBites.IO. Browse, read and write an Azure Storage container through the same FileSystem API used for local disk and other storages.</Description>
    <PackageTags>file;files;filesystem;storage;sync;azure;blob;azure-storage</PackageTags>
    <PackageProjectUrl>https://www.tagbites.com/io</PackageProjectUrl>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\src\TagBites.IO\TagBites.IO.csproj" Condition="$(SolutionName.EndsWith('-dev'))" />
    <PackageReference Include="TagBites.IO" Version="1.3.13" Condition="!$(SolutionName.EndsWith('-dev'))" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
  </ItemGroup>

</Project>
